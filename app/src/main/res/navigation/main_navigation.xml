<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/homeFragment">
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.githubuser.ui.home.HomeFragment"
        android:label="fragment_user_list"
        tools:layout="@layout/fragment_userlist" >
        <action
            android:id="@+id/action_userListFragment_to_detailFragment"
            app:destination="@id/detailFragment"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_homeFragment_to_favorite_navigation"
            app:destination="@id/favorite_navigation" />
    </fragment>
    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.githubuser.ui.detail.DetailFragment"
        android:label="fragment_detail"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="userId"
            app:argType="integer" />
        <deepLink
            android:id="@+id/deepLink"
            app:uri="android-app://com.example.githubuser/fragment_detail/{userId}/{userLogin}/{userIsFavorite}" />
        <argument
            android:name="userLogin"
            app:argType="string" />
        <argument
            android:name="userIsFavorite"
            app:argType="boolean" />
    </fragment>
    <include-dynamic
        android:id="@+id/favorite_navigation"
        app:moduleName="favorite"
        app:graphResName="favorite_navigation"
        app:graphPackage="com.example.githubuser.favorite"/>
</navigation>